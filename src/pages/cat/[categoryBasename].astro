---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import {
	getCategories,
	getEntriesForCategory,
} from '../../lib/content';

export const getStaticPaths = async () =>
	(await Promise.all(
		getCategories().map(async (category) => ({
		params: { categoryBasename: category.basename },
		props: {
			category,
			entries: await getEntriesForCategory(category.id),
		},
		})),
	));

const { category, entries } = Astro.props;
---

<BaseLayout title={`${category.label} - Cameron's Thoughts`}>
	<cindor-breadcrumbs class="breadcrumbs">
		<li><a href="/">Posts</a></li>
		<li><a href="/archives">Archives</a></li>
		<li aria-current="page">{category.label}</li>
	</cindor-breadcrumbs>
	<cindor-stack gap="4">
		<header class="collection-heading">
			<h1 class="surface-heading">{category.label}</h1>
			<p class="collection-count">{entries.length} {entries.length === 1 ? 'post' : 'posts'}</p>
		</header>
		<EntryList entries={entries} groupBy="year" showCategory={false} />
	</cindor-stack>
</BaseLayout>
