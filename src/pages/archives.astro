---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories, getEntriesForCategory, getEntriesForYear, getEntryYears } from '../lib/content';

const years = (await getEntryYears()).slice().reverse();
const categories = await Promise.all(
	getCategories().slice().sort((a, b) => a.label.localeCompare(b.label)).map(async (category) => ({
		...category,
		entryCount: (await getEntriesForCategory(category.id)).length,
	})),
);
const entriesPerYear = new Map(await Promise.all(years.map(async (year) => [year, (await getEntriesForYear(year)).length])));
---

<BaseLayout title="Archives - Cameron's Thoughts" shellWidth="wide">
	<div class="archive-shell">
		<header class="collection-heading">
			<h1 class="surface-heading">Archives</h1>
			<p class="collection-count">{[...entriesPerYear.values()].reduce((sum, count) => sum + count, 0)} posts · {years.at(-1)}–{years[0]}</p>
		</header>
		<section aria-labelledby="archive-years-heading">
			<h2 class="archive-section__heading" id="archive-years-heading"><cindor-icon name="calendar-days" size="18" aria-hidden="true"></cindor-icon> By year</h2>
			<ul class="archive-years" role="list">
				{years.map((year) => (
					<li>
						<a class="archive-year" href={`/${year}`}>
							<span class="archive-year__label">{year}</span>
							<span class="archive-year__count">{entriesPerYear.get(year)} {entriesPerYear.get(year) === 1 ? 'post' : 'posts'}</span>
							<cindor-icon name="arrow-up-right" size="18" aria-hidden="true"></cindor-icon>
						</a>
					</li>
				))}
			</ul>
		</section>
		<section aria-labelledby="archive-categories-heading">
			<h2 class="archive-section__heading" id="archive-categories-heading"><cindor-icon name="folder" size="18" aria-hidden="true"></cindor-icon> By category</h2>
			<cindor-card>
				<ul class="archive-categories" role="list">
					{categories.map((category) => (
						<li>
							<a class="archive-category" href={`/cat/${category.basename}`}>
								<span>{category.label}</span>
								<cindor-badge>{category.entryCount}</cindor-badge>
								<cindor-icon name="chevron-right" size="15" aria-hidden="true"></cindor-icon>
							</a>
						</li>
					))}
				</ul>
			</cindor-card>
		</section>
	</div>
</BaseLayout>
