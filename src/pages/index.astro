---
import Excerpt from '../components/Excerpt.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCanonicalEntries } from '../lib/content';

const recentEntries = (await getCanonicalEntries()).slice(1).slice(-5).reverse();
---

<BaseLayout>
	<div class="feed-grid">
		{recentEntries.map((entry, index) => <Excerpt entry={entry} featured={index === 0} />)}
	</div>
	<div class="feed-footer">
		<cindor-link class="action-link" href="/archives">All posts <cindor-icon name="arrow-right" size="18" aria-hidden="true"></cindor-icon></cindor-link>
	</div>
</BaseLayout>
